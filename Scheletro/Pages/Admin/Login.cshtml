@page
@model Scheletro.Pages.Admin.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Accesso area riservata";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Scheletro.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/bootstrap-icons-1.13.1/bootstrap-icons.css" asp-append-version="true" />
    <style>
        :root {
            --login-bg-start: #f7fafb;
            --login-bg-end: #dce6eb;
            --login-card-shadow: rgba(17, 24, 39, 0.16);
            --login-border: #d7e2e8;
            --login-text: #243746;
            --login-muted: #5c6f7c;
            --login-accent-soft: #eef7f1;
            --login-danger-bg: #fff4f2;
            --login-danger-border: #f0c3bc;
            --login-danger-text: #9d2a1a;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--login-text);
            background:
                radial-gradient(circle at top left, rgba(255, 255, 255, 0.92), transparent 34%),
                linear-gradient(145deg, var(--login-bg-start) 0%, var(--login-bg-end) 100%);
        }

        .login-shell {
            width: min(980px, 100%);
        }

        .login-card {
            border: 0;
            border-radius: 28px;
            overflow: hidden;
            box-shadow: 0 24px 60px var(--login-card-shadow);
            background: rgba(255, 255, 255, 0.95);
        }

        .login-hero {
            height: 100%;
            padding: 44px 40px;
            color: #fff;
            background: black;
            /* background:
                linear-gradient(180deg, rgba(15, 23, 42, 0.14), rgba(15, 23, 42, 0.24)),
                linear-gradient(160deg, #1f6d85 0%, #245c8f 48%, #1f8a63 100%); */
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-hero-logo {
            max-width: 220px;
            margin-bottom: 36px;
        }

        .login-hero-title {
            margin-bottom: 12px;
            font-size: 2rem;
            font-weight: 700;
            line-height: 1.15;
        }

        .login-hero-text {
            margin: 0;
            max-width: 28rem;
            font-size: 1rem;
            line-height: 1.65;
            color: rgba(255, 255, 255, 0.88);
        }

        .login-brand {
            margin-top: 36px;
            max-width: 140px;
        }

        .login-panel {
            padding: 44px 40px;
        }

        .login-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #1b5e20;
            background: #edf7ef;
        }

        .login-heading {
            margin-top: 18px;
            margin-bottom: 10px;
            font-size: 2rem;
            font-weight: 700;
        }

        .login-subtitle {
            margin-bottom: 28px;
            color: var(--login-muted);
            line-height: 1.6;
        }

        .form-label {
            margin-bottom: 8px;
            font-weight: 600;
            color: #334a5a;
        }

        .input-group-text,
        .form-control {
            min-height: 54px;
            border-color: var(--login-border);
            background: #f8fbfc;
        }

        .input-group-text {
            color: #4e6474;
        }

        .form-control {
            font-size: 1rem;
        }

        .form-control:focus {
            background: #fff;
            border-color: #7cb194;
            box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.12);
        }

        .field-validation-valid {
            display: none;
        }

        .field-validation-error {
            display: block;
            margin-top: 8px;
            color: var(--login-danger-text);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors {
            margin-top: 18px;
            padding: 14px 16px;
            border: 1px solid var(--login-danger-border);
            border-radius: 16px;
            background: var(--login-danger-bg);
            color: var(--login-danger-text);
        }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1.2rem;
        }

        .login-actions {
            display: flex;
            gap: 12px;
            margin-top: 26px;
        }

        .btn {
            min-height: 50px;
            font-weight: 600;
            border-radius: 14px;
        }

        .btn-cancel {
            color: #334155;
            background: #eef3f6;
            border-color: #d6e0e7;
        }

        .btn-cancel:hover {
            color: #1f2937;
            background: #e3eaee;
            border-color: #cbd6de;
        }

        .login-status {
            display: none;
            align-items: center;
            gap: 10px;
            margin-top: 16px;
            padding: 12px 14px;
            border: 1px solid #cfe4d7;
            border-radius: 14px;
            background: var(--login-accent-soft);
            color: #1e5f3d;
            font-weight: 500;
        }

        .login-status.is-visible {
            display: flex;
        }

        .login-form.is-submitting .form-control,
        .login-form.is-submitting .btn-cancel {
            pointer-events: none;
        }

        .submit-wait {
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        @@media (max-width: 991.98px) {
            .login-hero,
            .login-panel {
                padding: 34px 28px;
            }
        }

        @@media (max-width: 767.98px) {
            body {
                padding: 16px;
            }

            .login-heading {
                font-size: 1.75rem;
            }

            .login-actions {
                flex-direction: column-reverse;
            }
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="card login-card">
            <div class="row g-0">
                <div class="col-lg-5">
                    <section class="login-hero">
                        <img src="~/img/AppLogo.png" alt="WelDesk" class="img-fluid login-hero-logo" />
                        <h1 class="login-hero-title">Accesso alla piattaforma</h1>
                        <p class="login-hero-text">
                            Dopo il login il sistema legge il ruolo dal database, lo salva nei claims
                            del cookie e ti porta automaticamente nell'area corretta.
                        </p>
                        <img src="~/img/asw.png" alt="Armonia Software" class="img-fluid login-brand" />
                    </section>
                </div>

                <div class="col-lg-7">
                    <section class="login-panel">
                        <span class="login-badge">
                            <i class="bi bi-shield-lock"></i>
                            Accesso autenticato
                        </span>

                        <h2 class="login-heading">Bentornato</h2>
                        <p class="login-subtitle">
                            Inserisci username e password. Quando premi Invio o il pulsante di accesso,
                            verra mostrato un messaggio di attesa fino al completamento della verifica
                            delle credenziali e del ruolo associato.
                        </p>

                        <form id="loginForm" method="post" class="login-form" novalidate>
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label">Username</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input asp-for="Username"
                                           class="form-control"
                                           placeholder="Inserisci username"
                                           autocomplete="username"
                                           data-keyboard="username"
                                           autofocus />
                                </div>
                                <span asp-validation-for="Username"></span>
                            </div>

                            <div class="mb-2">
                                <label asp-for="Password" class="form-label">Password</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           placeholder="Inserisci password"
                                           autocomplete="current-password"
                                           data-keyboard="password" />
                                </div>
                                <span asp-validation-for="Password"></span>
                            </div>

                            <div asp-validation-summary="ModelOnly"></div>

                            <div class="login-actions">
                                <button type="button" class="btn btn-cancel flex-fill" id="btnAnnulla">Annulla</button>
                                <button type="submit" class="btn btn-success flex-fill" id="btnAccedi">
                                    <span class="submit-label">Accedi</span>
                                    <span class="submit-wait d-none">
                                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                        Accesso in corso...
                                    </span>
                                </button>
                            </div>

                            <div id="loginStatus" class="login-status" role="status" aria-live="polite">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>Verifica credenziali in corso, attendere...</span>
                            </div>
                        </form>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("loginForm");
            const cancelButton = document.getElementById("btnAnnulla");
            const submitButton = document.getElementById("btnAccedi");
            const submitLabel = submitButton?.querySelector(".submit-label");
            const submitWait = submitButton?.querySelector(".submit-wait");
            const statusBox = document.getElementById("loginStatus");
            let isSubmitting = false;

            const setSubmitting = (value) => {
                isSubmitting = value;
                form.classList.toggle("is-submitting", value);

                if (submitButton) {
                    submitButton.disabled = value;
                    submitButton.setAttribute("aria-busy", value ? "true" : "false");
                }

                if (cancelButton) {
                    cancelButton.disabled = value;
                }

                form.querySelectorAll("input").forEach((input) => {
                    input.readOnly = value;
                });

                submitLabel?.classList.toggle("d-none", value);
                submitWait?.classList.toggle("d-none", !value);
                statusBox?.classList.toggle("is-visible", value);
            };

            form?.addEventListener("submit", (event) => {
                if (isSubmitting) {
                    event.preventDefault();
                    return;
                }

                if (window.jQuery && typeof window.jQuery(form).valid === "function" && !window.jQuery(form).valid()) {
                    return;
                }

                setSubmitting(true);
            });

            cancelButton?.addEventListener("click", () => {
                if (isSubmitting) {
                    return;
                }

                form?.reset();
                form?.querySelector("input[name='Username']")?.focus();
            });
        })();
    </script>
</body>
</html>
