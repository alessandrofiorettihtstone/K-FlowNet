<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scheletro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Scheletro.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/bootstrap-icons-1.13.1/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    <script src="~/js/kiosk-keyboard.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/css/intlTelInput.css">
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.11/build/js/intlTelInput.min.js"></script>

</head>
<body>

    <main id="page-content" data-page-transition-root>
        @RenderBody()
    </main>

    <div class="offcanvas offcanvas-bottom keyboard-offcanvas"
         tabindex="-1"
         id="kioskKeyboard"
         data-bs-backdrop="false"
         data-bs-scroll="true">

        <div class="offcanvas-body">

            @*         <div id="keyboardPreview" class="keyboard-preview"></div>
 *@
            <div id="keyboardKeys" class="keyboard-keys"></div>

            <div class="keyboard-actions">
                <button type="button"
                        class="btn keyboard-action-btn keyboard-btn-close"
                        onclick="KioskKeyboard.close()">
                    <i class="bi bi-x-circle me-1"></i>
                    Chiudi
                </button>

                <div class="keyboard-right-actions">
                    <button type="button"
                            class="btn keyboard-action-btn keyboard-btn-clear"
                            onclick="KioskKeyboard.clear()">
                        <i class="bi bi-trash3 me-1"></i>
                        Svuota
                    </button>

                    <button type="button"
                            class="btn keyboard-action-btn keyboard-btn-next"
                            onclick="KioskKeyboard.next()">
                        <i class="bi bi-arrow-right me-1"></i>
                        Avanti
                    </button>

                    <button type="button"
                            class="btn keyboard-action-btn keyboard-btn-confirm"
                            ontouchend="KioskKeyboard.confirm(); event.preventDefault();"
                            onclick="KioskKeyboard.confirm()">
                        <i class="bi bi-check2-circle me-1"></i>
                        Conferma
                    </button>
                </div>
            </div>

        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
<style>
    .keyboard-offcanvas {
        height: 37vh !important;
        min-height: 320px;
        max-height: 430px;
        background: linear-gradient(180deg, #fcfdff 0%, #faf8ff 100%);
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        border-top: 1px solid rgba(153, 204, 255, 0.55);
        box-shadow: 0 -12px 30px rgba(70, 100, 140, 0.14);
    }

        .keyboard-offcanvas .offcanvas-body {
            padding: 16px 18px 18px;
        }

    .keyboard-preview {
        min-height: 60px;
        padding: 14px 18px;
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid rgba(153, 204, 255, 0.45);
        color: #4b627d;
        font-size: 1.08rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        word-break: break-word;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.03);
    }

    .keyboard-keys {
        display: grid;
        gap: 10px;
        margin-top: 12px;
    }

    .keyboard-row {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .keyboard-key {
        min-width: 54px;
        height: 50px;
        padding: 0 12px;
        border-radius: 14px;
        border: 1px solid rgba(153, 204, 255, 0.42);
        background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
        color: #4b627d;
        font-size: 1rem;
        font-weight: 600;
        box-shadow: 0 2px 6px rgba(80, 110, 150, 0.08);
        transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.08s ease, box-shadow 0.12s ease;
    }

        .keyboard-key:hover {
            background: #f3f9ff;
            border-color: #99CCFF;
        }

        .keyboard-key:active,
        .keyboard-key.active-touch {
            background: #E5CCFF;
            border-color: #c9aaf0;
            color: #4b627d;
            transform: scale(0.97);
            box-shadow: inset 0 2px 5px rgba(120, 100, 160, 0.10);
        }

        .keyboard-key.backspace-key {
            min-width: 64px;
            background: #f4f8fc;
            border-color: rgba(153, 204, 255, 0.60);
            font-size: 1.15rem;
        }

            .keyboard-key.backspace-key:active,
            .keyboard-key.backspace-key.active-touch {
                background: #E5CCFF;
                border-color: #c9aaf0;
            }

    .keyboard-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 14px;
        padding-top: 12px;
        border-top: 1px solid rgba(229, 204, 255, 0.65);
        gap: 10px;
    }

    .keyboard-right-actions {
        display: flex;
        gap: 10px;
    }

    .keyboard-action-btn {
        height: 44px;
        padding: 0 18px;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid transparent;
        transition: background-color 0.12s ease, border-color 0.12s ease, transform 0.08s ease, box-shadow 0.12s ease;
        box-shadow: 0 2px 8px rgba(80, 110, 150, 0.06);
    }

        .keyboard-action-btn:active,
        .keyboard-action-btn.active-touch {
            transform: scale(0.97);
        }

    .keyboard-btn-close {
        background: #ffffff;
        border-color: rgba(153, 204, 255, 0.32);
        color: #6a7482;
    }

        .keyboard-btn-close:hover {
            background: #f8fbfe;
            border-color: rgba(153, 204, 255, 0.52);
            color: #596473;
        }

        .keyboard-btn-close:active,
        .keyboard-btn-close.active-touch {
            background: #eef4fa;
            border-color: rgba(153, 204, 255, 0.72);
        }

    .keyboard-btn-clear {
        background: #f7f7f8;
        border-color: rgba(160, 170, 180, 0.28);
        color: #6b7280;
    }

        .keyboard-btn-clear:hover {
            background: #efeff1;
            border-color: rgba(160, 170, 180, 0.42);
            color: #5f6774;
        }

        .keyboard-btn-clear:active,
        .keyboard-btn-clear.active-touch {
            background: #e4e7eb;
            border-color: #b8c0cc;
            color: #4f5866;
        }

    .keyboard-btn-confirm {
        background: #99CCFF;
        border-color: #99CCFF;
        color: #244c73;
        font-weight: 700;
    }

        .keyboard-btn-confirm:hover {
            background: #8bc5ff;
            border-color: #8bc5ff;
            color: #1f4569;
        }

        .keyboard-btn-confirm:active,
        .keyboard-btn-confirm.active-touch {
            background: #79bbfb;
            border-color: #79bbfb;
            color: #183c5d;
        }

    .offcanvas-backdrop {
        background-color: transparent !important;
    }

    @@media (max-width: 768px) {
        .keyboard-offcanvas {
            height: 40vh !important;
            min-height: 330px;
        }

        .keyboard-key {
            min-width: 48px;
            height: 46px;
            font-size: 0.94rem;
            border-radius: 12px;
        }

            .keyboard-key.backspace-key {
                min-width: 58px;
            }

        .keyboard-action-btn {
            height: 42px;
            padding: 0 14px;
            font-size: 0.9rem;
        }

        .keyboard-preview {
            min-height: 54px;
            font-size: 1rem;
        }
    }
</style>
