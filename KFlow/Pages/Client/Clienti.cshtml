@page "/Client/Clienti.cshtml"
@model Scheletro.Pages.Client.ClientiModel
@{
    Layout = "_KFlowLayout";
    ViewData["Title"] = "Clienti";
    ViewData["KFlowSuccessMessage"] = Model.SuccessMessage;
    ViewData["KFlowErrorMessage"] = Model.ErrorMessage;
    var returnUrl = HttpContext.Request.Path + HttpContext.Request.QueryString;
}

<form method="get" class="kflow-board-toolbar">
    <section class="kflow-panel">
        <div class="kflow-panel-header d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2>Ricerca</h2>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createClienteModal">
                <i class="bi bi-plus-lg me-1"></i>
                Nuovo cliente
            </button>
        </div>
        <div class="kflow-panel-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label asp-for="Filters.Search" class="form-label">Cliente</label>
                    <div class="input-group kflow-autocomplete-wrapper">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input asp-for="Filters.Search" class="form-control" placeholder="Codice o ragione sociale" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" title="Pulisci cliente" aria-label="Pulisci cliente" data-clear-target="#Filters_Search">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <label asp-for="Filters.PartnerType" class="form-label">Tipo</label>
                    <select asp-for="Filters.PartnerType" class="form-select">
                        <option value="">Tutti i tipi</option>
                        @foreach (var item in Model.PartnerTypeOptions)
                        {
                            <option value="@item.Value" selected="@(Model.Filters.PartnerType == item.Value)">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label asp-for="Filters.Sector" class="form-label">Settore</label>
                    <input asp-for="Filters.Sector" class="form-control" type="number" min="0" />
                </div>
                <div class="col-md-2 d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" href="/Client/Clienti.cshtml">Pulisci</a>
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search me-1"></i>
                        Cerca
                    </button>
                </div>
            </div>
        </div>
    </section>
</form>

<section class="kflow-panel kflow-data-panel">
    <div class="kflow-panel-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2>Elenco clienti</h2>
        <span class="text-muted small">@Model.Rows.Count clienti</span>
    </div>
    <div class="kflow-panel-body p-0">
        @if (Model.Rows.Count == 0)
        {
            <div class="kflow-empty-column">Nessun cliente trovato.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 kflow-data-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Tipo</th>
                            <th class="text-end">Settore</th>
                            <th class="text-end">Ubicazioni</th>
                            <th class="text-end">Combination</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@row.Name</div>
                                    <div class="text-muted small">@row.ID</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@row.PartnerType</span>
                                </td>
                                <td class="text-end">@row.Sector</td>
                                <td class="text-end">@row.LocationCount.ToString("N0")</td>
                                <td class="text-end">@row.CombinationCount.ToString("N0")</td>
                                <td class="text-end">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Modifica cliente"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editClienteModal"
                                            data-edit-guid="@row.Guid"
                                            data-edit-type="@row.PartnerType"
                                            data-edit-id="@row.ID"
                                            data-edit-name="@row.Name"
                                            data-edit-sector="@row.Sector">
                                        <i class="bi bi-pencil-square me-1"></i>
                                        Modifica
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

<div class="modal fade" id="createClienteModal" tabindex="-1" aria-labelledby="createClienteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="createClienteModalLabel">Nuovo cliente</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="Filters.Search" value="@Model.Filters.Search" />
                    <input type="hidden" name="Filters.PartnerType" value="@Model.Filters.PartnerType" />
                    <input type="hidden" name="Filters.Sector" value="@Model.Filters.Sector" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="Input.PartnerType" class="form-label">Tipo</label>
                            <select asp-for="Input.PartnerType" asp-items="Model.PartnerTypeOptions" class="form-select"></select>
                            <span asp-validation-for="Input.PartnerType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.ID" class="form-label">Codice cliente</label>
                            <input asp-for="Input.ID" class="form-control" maxlength="50" autocomplete="off" />
                            <span asp-validation-for="Input.ID" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Input.Sector" class="form-label">Settore</label>
                            <input asp-for="Input.Sector" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Input.Sector" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.Name" class="form-label">Ragione sociale</label>
                            <input asp-for="Input.Name" class="form-control" maxlength="50" autocomplete="off" />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Crea cliente
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editClienteModal" tabindex="-1" aria-labelledby="editClienteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editClienteModalLabel">Modifica cliente</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <input type="hidden" name="Filters.Search" value="@Model.Filters.Search" />
                    <input type="hidden" name="Filters.PartnerType" value="@Model.Filters.PartnerType" />
                    <input type="hidden" name="Filters.Sector" value="@Model.Filters.Sector" />
                    <input asp-for="EditInput.Guid" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="editClienteTypeDisplay">Tipo</label>
                            <input id="editClienteTypeDisplay" class="form-control" value="@Model.EditInput.PartnerType" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="editClienteIdDisplay">Codice cliente</label>
                            <input id="editClienteIdDisplay" class="form-control" value="@Model.EditInput.ID" readonly />
                        </div>
                        <div class="col-md-5">
                            <label asp-for="EditInput.Sector" class="form-label">Settore</label>
                            <input asp-for="EditInput.Sector" class="form-control" type="number" min="0" />
                            <span asp-validation-for="EditInput.Sector" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="EditInput.Name" class="form-label">Ragione sociale</label>
                            <input asp-for="EditInput.Name" class="form-control" maxlength="50" autocomplete="off" />
                            <span asp-validation-for="EditInput.Name" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annulla</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>
                        Salva modifiche
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const firstLookupValue = value => {
                const separatorIndex = value.indexOf(" - ");
                return separatorIndex > 0 ? value.slice(0, separatorIndex).trim() : value;
            };

            setupKFlowAutocomplete({
                inputSelector: "#Filters_Search",
                url: "/Client/Clienti.cshtml",
                tipoRicerca: "CLIENTE",
                emptyText: "Nessun cliente trovato",
                submitOnSelect: true,
                getSelectedValue: firstLookupValue
            });
            setupKFlowFilterClear();

            const setValue = (id, value) => {
                const element = document.getElementById(id);
                if (element) {
                    element.value = value || "";
                }
            };

            const showModal = modalId => {
                const modalElement = document.getElementById(modalId);
                if (modalElement && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            };

            const editModal = document.getElementById("editClienteModal");
            editModal?.addEventListener("show.bs.modal", event => {
                const button = event.relatedTarget;
                if (!button) {
                    return;
                }

                setValue("EditInput_Guid", button.getAttribute("data-edit-guid"));
                setValue("editClienteTypeDisplay", button.getAttribute("data-edit-type"));
                setValue("editClienteIdDisplay", button.getAttribute("data-edit-id"));
                setValue("EditInput_Name", button.getAttribute("data-edit-name"));
                setValue("EditInput_Sector", button.getAttribute("data-edit-sector"));
            });

            const showRequestedModals = () => {
                @if (Model.ShowCreateModal)
                {
                    <text>showModal("createClienteModal");</text>
                }
                @if (Model.ShowEditModal)
                {
                    <text>showModal("editClienteModal");</text>
                }
            };

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", showRequestedModals);
            } else {
                showRequestedModals();
            }
        })();
    </script>
}
