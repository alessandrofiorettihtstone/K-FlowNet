@page "/Client/Login.cshtml"
@model Scheletro.Pages.Client.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - K-Flow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/bootstrap-icons-1.13.1/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kflow.css" asp-append-version="true" />
</head>
<body class="kflow-login-page">
    <section class="kflow-login-card">
        <div class="kflow-login-brand">
            <img src="~/img/K-Flow.png" alt="K-Flow" />
        </div>
        <div class="kflow-login-form">
            <div class="text-center mb-3">
                <img src="~/img/ASW.png" alt="Logo" height="54" />
            </div>
            <hr />
            <h1>Accesso</h1>
            <hr />
            <form id="loginForm" method="post" novalidate>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <span asp-validation-summary="ModelOnly"></span>
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-fill" aria-hidden="true"></i></span>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill" aria-hidden="true"></i></span>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="kflow-login-divider">o</div>

                <div class="mb-4">
                    <label asp-for="CID" class="form-label">CID</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-vcard-fill" aria-hidden="true"></i></span>
                        <input asp-for="CID" class="form-control" autocomplete="off" />
                    </div>
                    <span asp-validation-for="CID" class="text-danger small"></span>
                </div>

                <label class="kflow-remember-option mb-3" for="RememberMe">
                    <span class="kflow-remember-copy">
                        <span class="kflow-remember-icon" aria-hidden="true"><i class="bi bi-shield-lock-fill"></i></span>
                        <span>
                            <strong>Resta collegato</strong>
                            <small>Ricorda l’accesso su questo dispositivo</small>
                        </span>
                    </span>
                    <span class="form-check form-switch m-0">
                        <input asp-for="RememberMe" class="form-check-input" role="switch" />
                    </span>
                </label>

                <div class="kflow-login-actions">
                    <button id="btnClear" type="button" class="kflow-action-button kflow-action-button-danger">
                        <span class="kflow-action-icon" aria-hidden="true"><i class="bi bi-x-circle-fill"></i></span>
                        <span class="kflow-action-copy">
                            <span class="kflow-action-title">Annulla</span>
                            <span class="kflow-action-subtitle">Svuota i campi</span>
                        </span>
                        <i class="bi bi-chevron-right kflow-action-arrow" aria-hidden="true"></i>
                    </button>
                    <button id="btnLogin" type="submit" class="kflow-action-button kflow-action-button-success">
                        <span class="kflow-action-icon" aria-hidden="true"><i class="bi bi-box-arrow-in-right"></i></span>
                        <span class="kflow-action-copy">
                            <span class="kflow-action-title login-label">Accedi</span>
                            <span class="kflow-action-subtitle login-label-subtitle">Avvia la sessione</span>
                            <span class="login-wait d-none">
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                Attendere
                            </span>
                        </span>
                        <i class="bi bi-chevron-right kflow-action-arrow" aria-hidden="true"></i>
                    </button>
                </div>
            </form>
        </div>
    </section>

    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("loginForm");
            const clear = document.getElementById("btnClear");
            const submit = document.getElementById("btnLogin");
            const label = submit?.querySelector(".login-label");
            const subtitle = submit?.querySelector(".login-label-subtitle");
            const wait = submit?.querySelector(".login-wait");

            const restoreLoginButton = () => {
                submit?.removeAttribute("disabled");
                label?.classList.remove("d-none");
                subtitle?.classList.remove("d-none");
                wait?.classList.add("d-none");
            };

            clear?.addEventListener("click", () => {
                form?.reset();
                form?.querySelector("input[name='Username']")?.focus();
            });

            form?.addEventListener("submit", event => {
                if (event.submitter !== submit) {
                    restoreLoginButton();
                    return;
                }

                submit?.setAttribute("disabled", "disabled");
                label?.classList.add("d-none");
                subtitle?.classList.add("d-none");
                wait?.classList.remove("d-none");
            });

            form?.addEventListener("keydown", event => {
                if (event.key === "Enter" && event.target.matches("input")) {
                    event.preventDefault();
                    form.requestSubmit(submit);
                }
            });

            window.addEventListener("pageshow", restoreLoginButton);
        })();
    </script>
</body>
</html>
