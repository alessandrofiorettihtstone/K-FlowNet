@{
    var successMessage = ViewData["KFlowSuccessMessage"] as string;
    var errorMessage = ViewData["KFlowErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage) || !string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="toast-container kflow-toast-container p-3">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="toast kflow-toast kflow-toast-success border-0 shadow"
                 role="status"
                 aria-live="polite"
                 aria-atomic="true"
                 data-kflow-toast
                 data-bs-delay="2500">
                <div class="toast-header">
                    <span class="kflow-toast-icon kflow-toast-icon-success">
                        <i class="bi bi-check2"></i>
                    </span>
                    <strong class="me-auto">Operazione completata</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Chiudi"></button>
                </div>
                <div class="toast-body">
                    @successMessage
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="toast kflow-toast kflow-toast-error border-0 shadow"
                 role="alert"
                 aria-live="assertive"
                 aria-atomic="true"
                 data-kflow-toast
                 data-bs-delay="2500">
                <div class="toast-header">
                    <span class="kflow-toast-icon kflow-toast-icon-error">
                        <i class="bi bi-exclamation-lg"></i>
                    </span>
                    <strong class="me-auto">Operazione non completata</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Chiudi"></button>
                </div>
                <div class="toast-body">
                    @errorMessage
                </div>
            </div>
        }
    </div>
}
