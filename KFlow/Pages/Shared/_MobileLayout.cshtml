@using Scheletro.Class
@{
    var title = ViewData["Title"] as string ?? "Mobile";
    var path = Context.Request.Path.Value ?? string.Empty;
    var isHome = path.EndsWith("/Default.cshtml", StringComparison.OrdinalIgnoreCase);
    var isReader = path.Contains("LeggiCartellinoMain", StringComparison.OrdinalIgnoreCase);
    var isPicking = path.Contains("Prelievo", StringComparison.OrdinalIgnoreCase);
    var displayName = User.Identity?.IsAuthenticated == true ? AuthConfiguration.GetDisplayName(User) : "Accesso";
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <title>@title - K-Flow Mobile</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/bootstrap-icons-1.13.1/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kflow.css" asp-append-version="true" />
</head>
<body class="kflow-mobile-app@(isPicking ? " is-picking" : "")">
    <nav class="navbar navbar-dark kflow-mobile-navbar">
        <div class="container-fluid">
            <a class="kflow-brand" href="/Mobile/Default.cshtml">
                <img src="~/img/navK-Flow.png" alt="K-Flow" height="40" />
            </a>
            <button class="btn btn-outline-light" type="button" data-bs-toggle="modal" data-bs-target="#mobileLogoutModal">
                <i class="bi bi-person-circle me-1"></i>
                @displayName
            </button>
        </div>
    </nav>

    <main class="kflow-mobile-content">
        @RenderBody()
    </main>

    <nav class="kflow-bottom-nav" aria-label="Navigazione mobile">
        <a class="@(isHome ? "active" : "")" href="/Mobile/Default.cshtml">
            <i class="bi bi-house"></i>
            <span>Home</span>
        </a>
        <a class="@(isReader ? "active" : "")" href="/Mobile/LeggiCartellinoMain.cshtml">
            <i class="bi bi-upc-scan"></i>
            <span>Leggi</span>
        </a>
        <a class="@(isPicking ? "active" : "")" href="/Mobile/Prelievo.cshtml" aria-label="Prelievo">
            <i class="bi bi-box-seam"></i>
            <span>Prelievo</span>
        </a>
    </nav>

    <div class="modal fade" id="mobileLogoutModal" tabindex="-1" aria-labelledby="mobileLogoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header text-bg-dark">
                    <h2 class="modal-title fs-6" id="mobileLogoutModalLabel"><i class="bi bi-person-circle me-2"></i>@displayName</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <div class="modal-body">Vuoi disconnetterti dal terminale?</div>
                <div class="modal-footer d-flex flex-nowrap gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-fill" data-bs-dismiss="modal">Annulla</button>
                    <form method="get" action="/Mobile/Logout.cshtml" class="flex-fill">
                        <button type="submit" class="btn btn-danger w-100"><i class="bi bi-box-arrow-right me-1"></i>Esci</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileUserPanel" aria-labelledby="mobileUserPanelLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mobileUserPanelLabel">Dati utente</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Chiudi"></button>
        </div>
        <div class="offcanvas-body">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <dl class="kflow-user-details">
                    <dt>Nome</dt>
                    <dd>@(User.Claims.FirstOrDefault(x => x.Type == System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "-")</dd>
                    <dt>Cognome</dt>
                    <dd>@(User.Claims.FirstOrDefault(x => x.Type == System.Security.Claims.ClaimTypes.Surname)?.Value ?? "-")</dd>
                    <dt>Username</dt>
                    <dd>@(User.Identity?.Name ?? "-")</dd>
                </dl>
                <a class="btn btn-danger w-100" href="/Mobile/Logout.cshtml">
                    <i class="bi bi-box-arrow-right me-1"></i>
                    Disconnetti
                </a>
            }
            else
            {
                <p class="text-muted">Effettua il login tramite CID dalla schermata iniziale.</p>
            }
        </div>
    </div>

    <partial name="_KFlowToasts" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/html5-qrcode.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (() => {
            const mobileFields = () => Array.from(document.querySelectorAll(
                ".kflow-mobile-content input:not([type='hidden']):not([type='button']):not([type='submit']):not([type='reset']), .kflow-mobile-content select, .kflow-mobile-content textarea"
            )).filter(field => !field.disabled && !field.readOnly && field.getClientRects().length > 0);

            window.setTimeout(() => {
                const preferredField = document.querySelector(".kflow-mobile-content [data-focus-target='true']");
                const firstField = preferredField ?? mobileFields()[0];
                firstField?.focus();
            }, 0);

            document.addEventListener("keydown", event => {
                if (event.key !== "Enter" || event.shiftKey || event.isComposing || event.target instanceof HTMLTextAreaElement) {
                    return;
                }

                if (event.defaultPrevented) {
                    return;
                }

                const fields = mobileFields();
                const currentIndex = fields.indexOf(event.target);
                const nextField = currentIndex >= 0 ? fields[currentIndex + 1] : null;

                if (nextField) {
                    event.preventDefault();
                    nextField.focus();
                }
            });

            window.kflowSetButtonLoading = button => {
                if (!button || button.disabled || button.dataset.kflowLoading === "true") {
                    return;
                }

                button.dataset.kflowLoading = "true";
                button.dataset.kflowOriginalHtml = button.innerHTML;
                button.disabled = true;
                button.setAttribute("aria-busy", "true");
                button.innerHTML = button.classList.contains("picking-row-action")
                    ? '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>'
                    : '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Attendere...';
            };

            document.addEventListener("submit", event => {
                if (event.defaultPrevented || !(event.submitter instanceof HTMLButtonElement)) {
                    return;
                }

                window.kflowSetButtonLoading(event.submitter);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
