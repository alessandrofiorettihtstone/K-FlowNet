@page "/Mobile/Prelievo.cshtml"
@model Scheletro.Pages.Mobile.PrelievoModel
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Prelievo";
    ViewData["KFlowSuccessMessage"] = Model.SuccessMessage;
    ViewData["KFlowErrorMessage"] = Model.ErrorMessage;
}

<section class="kflow-mobile-card picking-entry-card">
    <header class="picking-entry-header">
        <span class="picking-entry-icon"><i class="bi bi-box-seam"></i></span>
        <div>
            <h1>Registra prelievo</h1>
            <p>Scansiona il cartellino e completa i dati richiesti.</p>
        </div>
    </header>

    <div asp-validation-summary="ModelOnly" class="text-danger picking-validation"></div>

    <form method="post" novalidate class="picking-form">
        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                <input asp-for="Input.CardId" id="cardId" class="form-control" autocomplete="off" placeholder="Cartellino" required />
            </div>
        </div>

        <div class="picking-product-details" aria-live="polite">
            <div>
                <input id="productId" class="form-control" readonly placeholder="Articolo" />
            </div>
            <div>
                <div id="productDescription" class="picking-product-description" data-placeholder="Descrizione" aria-live="polite"></div>
            </div>
        </div>

        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                <input asp-for="Input.ProductionNumber" id="productionNumber" class="form-control" autocomplete="off" placeholder="Numero di picking (PckList)" required />
            </div>
        </div>

        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-123"></i></span>
                <input asp-for="Input.Quantity" id="quantity" class="form-control picking-quantity-input" type="text" inputmode="none" pattern="[0-9]*[,.]?[0-9]*" placeholder="Quantità" required />
            </div>
            <span id="quantityFeedback" asp-validation-for="Input.Quantity" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success w-100 picking-submit">
            <i class="bi bi-check2-circle"></i>Registra prelievo
        </button>
    </form>
</section>

<div class="modal fade quantity-keypad" id="quantityKeypad" tabindex="-1" aria-labelledby="quantityKeypadLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title" id="quantityKeypadLabel"><i class="bi bi-calculator me-2"></i>Inserisci quantità</h2>
                <button type="button" class="quantity-keypad-close" data-bs-dismiss="modal" aria-label="Chiudi">&times;</button>
            </div>
            <div class="modal-body">
                <output id="quantityKeypadValue" class="quantity-keypad-value" aria-live="polite">0</output>
                <div class="quantity-keypad-keys">
                    <button type="button" data-key="1">1</button>
                    <button type="button" data-key="2">2</button>
                    <button type="button" data-key="3">3</button>
                    <button type="button" data-key="4">4</button>
                    <button type="button" data-key="5">5</button>
                    <button type="button" data-key="6">6</button>
                    <button type="button" data-key="7">7</button>
                    <button type="button" data-key="8">8</button>
                    <button type="button" data-key="9">9</button>
                    <button type="button" data-key="," aria-label="Separatore decimale">,</button>
                    <button type="button" data-key="0">0</button>
                    <button type="button" class="quantity-keypad-delete" data-action="backspace" aria-label="Cancella ultima cifra"><i class="bi bi-backspace"></i></button>
                </div>
            </div>
            <div class="modal-footer d-flex flex-nowrap gap-2">
                <button type="button" class="btn btn-outline-secondary flex-fill" data-action="clear"><i class="bi bi-x-circle me-1"></i>Svuota</button>
                <button type="button" class="btn flex-fill quantity-keypad-confirm" id="confirmQuantityKeypad"><i class="bi bi-check2 me-1"></i>OK</button>
            </div>
        </div>
    </div>
</div>

@if (Model.PickingTransactions.Count > 0)
{
    <section class="kflow-mobile-card picking-history mt-3">
        <header class="picking-history-header">
            <div>
                <h2>Prelievi registrati</h2>
                <span>Articolo @Model.SelectedItemCode · Produzione @Model.SelectedProductionNumber</span>
            </div>
            <span class="picking-count">@Model.PickingTransactions.Count</span>
        </header>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Quantità</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.PickingTransactions)
                    {
                        <tr>
                            <td class="text-nowrap picking-date">@transaction.CreateDate.ToString("dd/MM HH:mm")</td>
                            <td>
                                <form method="post" asp-page-handler="Update" class="d-flex gap-1 picking-update-form" novalidate>
                                    <input type="hidden" name="id" value="@transaction.ID" />
                                    <input type="hidden" name="itemCode" value="@Model.SelectedItemCode" />
                                    <input type="hidden" name="production" value="@Model.SelectedProductionNumber" />
                                    <input name="quantity" class="form-control form-control-sm picking-row-quantity" type="text" inputmode="none" pattern="[0-9]*[,.]?[0-9]*" value="@transaction.Qty.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Quantità del prelievo @transaction.ID" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm picking-row-action" title="Salva quantità" aria-label="Salva quantità">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" class="d-inline picking-delete-form">
                                    <input type="hidden" name="id" value="@transaction.ID" />
                                    <input type="hidden" name="itemCode" value="@Model.SelectedItemCode" />
                                    <input type="hidden" name="production" value="@Model.SelectedProductionNumber" />
                                    <button type="button" class="btn btn-outline-danger btn-sm picking-row-action" title="Elimina movimento" aria-label="Elimina movimento" data-bs-toggle="modal" data-bs-target="#pickingDeleteModal">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<div class="modal fade" id="pickingErrorModal" tabindex="-1" aria-labelledby="pickingErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header text-bg-danger">
                <h2 class="modal-title fs-6" id="pickingErrorModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Attenzione</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body" id="pickingErrorMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger w-100" data-bs-dismiss="modal">Correggi</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="pickingDeleteModal" tabindex="-1" aria-labelledby="pickingDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header text-bg-danger">
                <h2 class="modal-title fs-6" id="pickingDeleteModalLabel"><i class="bi bi-trash3-fill me-2"></i>Elimina prelievo</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                Eliminare questo movimento? Non verrà cancellato dallo storico, ma sarà nascosto dall'elenco.
            </div>
            <div class="modal-footer d-flex flex-nowrap gap-2">
                <button type="button" class="btn btn-outline-secondary flex-fill" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-danger flex-fill" id="confirmPickingDelete">Elimina</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const cardInput = document.getElementById("cardId");
            const productInput = document.getElementById("productId");
            const productDescriptionInput = document.getElementById("productDescription");
            const productionInput = document.getElementById("productionNumber");
            const quantityInput = document.getElementById("quantity");
            const quantityKeypad = document.getElementById("quantityKeypad");
            const quantityKeypadValue = document.getElementById("quantityKeypadValue");
            const confirmQuantityKeypad = document.getElementById("confirmQuantityKeypad");
            const form = cardInput?.closest("form");
            const errorModalElement = document.getElementById("pickingErrorModal");
            const errorModalMessage = document.getElementById("pickingErrorMessage");
            const deleteModalElement = document.getElementById("pickingDeleteModal");
            const confirmDeleteButton = document.getElementById("confirmPickingDelete");
            let pendingDeleteForm = null;
            let activeQuantityInput = quantityInput;
            let activeQuantityForm = form;
            let activeQuantityOriginalValue = "";
            let quantityKeypadConfirmed = false;
            let suppressNextQuantityKeypad = false;
            const quantityKeypadModal = quantityKeypad ? bootstrap.Modal.getOrCreateInstance(quantityKeypad) : null;

            function showPickingError(message) {
                if (window.KFlowToast?.error) {
                    window.KFlowToast.error(message);
                    return;
                }

                if (!errorModalElement || !errorModalMessage) {
                    return;
                }

                errorModalMessage.textContent = message;
                bootstrap.Modal.getOrCreateInstance(errorModalElement).show();
            }

            function refreshQuantityKeypadValue() {
                if (quantityKeypadValue && activeQuantityInput) {
                    quantityKeypadValue.textContent = activeQuantityInput.value.replace(".", ",") || "0";
                }
            }

            function openQuantityKeypad(input, owningForm, originalValue = input.value) {
                activeQuantityInput = input;
                activeQuantityForm = owningForm;
                activeQuantityOriginalValue = originalValue;
                quantityKeypadConfirmed = false;
                refreshQuantityKeypadValue();
                quantityKeypadModal?.show();
            }

            if (!cardInput || !productInput || !productDescriptionInput) {
                return;
            }

            async function loadProduct() {
                const cardId = cardInput.value.trim();
                productInput.value = "";
                productDescriptionInput.textContent = "";
                cardInput.setCustomValidity("");

                if (!cardId) {
                    return false;
                }

                try {
                    const response = await fetch(`${window.location.pathname}?handler=CardInfo&cardId=${encodeURIComponent(cardId)}`, {
                        headers: { "Accept": "application/json" }
                    });
                    const result = await response.json();

                    if (!response.ok || !result.found) {
                        const message = result.message || "Cartellino non trovato.";
                        cardInput.setCustomValidity(message);
                        showPickingError(message);
                        cardInput.value = "";
                        cardInput.focus();
                        return false;
                    }

                    productInput.value = result.productId;
                    productDescriptionInput.textContent = result.productDescription || "";
                    return true;
                } catch {
                    const message = "Impossibile verificare il cartellino.";
                    cardInput.setCustomValidity(message);
                    showPickingError(message);
                    cardInput.value = "";
                    cardInput.focus();
                    return false;
                }
            }

            cardInput.addEventListener("change", loadProduct);
            cardInput.addEventListener("blur", loadProduct);
            cardInput.addEventListener("keydown", async event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                if (await loadProduct()) {
                    productionInput?.focus();
                } else {
                    cardInput.focus();
                }
            });

            productionInput?.addEventListener("keydown", async event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                const production = productionInput.value.trim();

                if (!production) {
                    productionInput.focus();
                    return;
                }

                try {
                    const response = await fetch(`${window.location.pathname}?handler=ProductionInfo&production=${encodeURIComponent(production)}`, {
                        headers: { "Accept": "application/json" }
                    });
                    const result = await response.json();

                    if (!response.ok || !result.found) {
                        const message = result.message || "Produzione non trovata.";
                        productionInput.setCustomValidity(message);
                        showPickingError(message);
                        productionInput.value = "";
                        productionInput.focus();
                        return;
                    }

                    productionInput.setCustomValidity("");
                } catch {
                    const message = "Impossibile verificare la produzione.";
                    productionInput.setCustomValidity(message);
                    showPickingError(message);
                    productionInput.value = "";
                    productionInput.focus();
                    return;
                }

                if (!productInput.value.trim() && !(await loadProduct())) {
                    return;
                }

                const parameters = new URLSearchParams({
                    itemCode: productInput.value.trim(),
                    production,
                    cardId: cardInput.value.trim()
                });
                window.location.assign(`${window.location.pathname}?${parameters.toString()}`);
            });

            quantityInput?.addEventListener("keydown", event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                form?.requestSubmit();
            });

            quantityInput?.addEventListener("focus", () => {
                if (suppressNextQuantityKeypad) {
                    suppressNextQuantityKeypad = false;
                    return;
                }

                openQuantityKeypad(quantityInput, form);
            });

            quantityInput?.addEventListener("click", () => {
                openQuantityKeypad(quantityInput, form);
            });

            quantityKeypad?.addEventListener("hide.bs.modal", () => {
                if (!quantityKeypadConfirmed && activeQuantityForm?.classList.contains("picking-update-form")) {
                    activeQuantityInput.value = activeQuantityOriginalValue;
                }

                suppressNextQuantityKeypad = true;
            });

            quantityKeypad?.addEventListener("pointerdown", event => {
                if (event.target.closest("button")) {
                    event.preventDefault();
                }
            });

            quantityKeypad?.addEventListener("click", event => {
                const button = event.target.closest("button");
                if (!button || !activeQuantityInput) {
                    return;
                }

                if (button.dataset.action === "clear") {
                    activeQuantityInput.value = "";
                } else if (button.dataset.action === "backspace") {
                    activeQuantityInput.value = activeQuantityInput.value.slice(0, -1);
                } else if (button.dataset.key) {
                    const key = button.dataset.key;
                    if ((key !== "." && key !== ",") || (!activeQuantityInput.value.includes(".") && !activeQuantityInput.value.includes(","))) {
                        activeQuantityInput.value += key;
                    }
                }

                activeQuantityInput.dispatchEvent(new Event("input", { bubbles: true }));
                refreshQuantityKeypadValue();
            });

            confirmQuantityKeypad?.addEventListener("click", () => {
                if (!activeQuantityInput || !activeQuantityForm) {
                    return;
                }

                activeQuantityInput.value = activeQuantityInput.value.replace(",", ".");
                quantityKeypadConfirmed = true;
                quantityKeypadModal?.hide();
                const submitButton = activeQuantityForm.querySelector("button[type='submit']");
                window.kflowSetButtonLoading?.(submitButton);
                activeQuantityForm.requestSubmit(submitButton);
            });

            if (cardInput.value.trim()) {
                loadProduct();
            }

            document.querySelectorAll(".picking-update-form").forEach(updateForm => {
                const rowQuantity = updateForm.querySelector(".picking-row-quantity");
                rowQuantity?.addEventListener("focus", event => {
                    if (suppressNextQuantityKeypad) {
                        suppressNextQuantityKeypad = false;
                        return;
                    }

                    event.target.select();
                    const originalValue = rowQuantity.value;
                    rowQuantity.value = "";
                    openQuantityKeypad(rowQuantity, updateForm, originalValue);
                });

                rowQuantity?.addEventListener("click", () => {
                    if (!quantityKeypad.classList.contains("show")) {
                        openQuantityKeypad(rowQuantity, updateForm);
                    }
                });

                updateForm.addEventListener("submit", event => {
                    const rowQuantity = updateForm.querySelector("[name='quantity']");
                    rowQuantity.value = rowQuantity.value.replace(",", ".");
                    const value = Number(rowQuantity.value);

                    if (!rowQuantity.value.trim() || !rowQuantity.validity.valid || !Number.isFinite(value) || value <= 0) {
                        event.preventDefault();
                        showPickingError("Inserisci una quantità numerica maggiore di zero.");
                        rowQuantity?.focus();
                    }
                });
            });

            document.querySelectorAll(".picking-delete-form").forEach(deleteForm => {
                deleteForm.querySelector("button")?.addEventListener("click", () => {
                    pendingDeleteForm = deleteForm;
                });

                deleteForm.addEventListener("submit", event => {
                    if (deleteForm.dataset.confirmed === "true") {
                        deleteForm.dataset.confirmed = "";
                        return;
                    }

                    event.preventDefault();
                    pendingDeleteForm = deleteForm;
                    bootstrap.Modal.getOrCreateInstance(deleteModalElement).show();
                });
            });

            confirmDeleteButton?.addEventListener("click", () => {
                if (!pendingDeleteForm) {
                    return;
                }

                window.kflowSetButtonLoading?.(confirmDeleteButton);
                pendingDeleteForm.dataset.confirmed = "true";
                pendingDeleteForm.requestSubmit();
            });

            deleteModalElement?.addEventListener("hidden.bs.modal", () => {
                pendingDeleteForm = null;
            });

            form?.addEventListener("submit", event => {
                const requiredFields = [
                    [cardInput, null, "Inserisci il cartellino."],
                    [productionInput, null, "Inserisci il numero di picking di produzione."],
                    [quantityInput, document.getElementById("quantityFeedback"), "Inserisci la quantità."]
                ];
                const missingField = requiredFields.find(([field, error, message]) => {
                    const isMissing = !field?.value.trim();
                    if (isMissing) {
                        field.classList.add("is-invalid");
                        if (error) {
                            error.textContent = error.textContent || "Campo obbligatorio.";
                        }
                        if (field === cardInput || field === productionInput) {
                            showPickingError(message);
                        }
                    } else {
                        field.classList.remove("is-invalid");
                    }
                    return isMissing;
                });

                if (missingField) {
                    event.preventDefault();
                    missingField[0].focus();
                    return;
                }

                quantityInput.value = quantityInput.value.replace(",", ".");
            });
        })();
    </script>
}
