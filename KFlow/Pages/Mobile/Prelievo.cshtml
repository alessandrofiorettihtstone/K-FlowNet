@page "/Mobile/Prelievo.cshtml"
@model Scheletro.Pages.Mobile.PrelievoModel
@{
    Layout = "_MobileLayout";
    ViewData["Title"] = "Prelievo";
}

<section class="kflow-mobile-card picking-entry-card">
    <header class="picking-entry-header">
        <span class="picking-entry-icon"><i class="bi bi-box-seam"></i></span>
        <div>
            <h1>Registra prelievo</h1>
            <p>Scansiona il cartellino e completa i dati richiesti.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success picking-feedback" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@Model.SuccessMessage
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger picking-validation"></div>

    <form method="post" novalidate class="picking-form">
        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                <input asp-for="Input.CardId" id="cardId" class="form-control" autocomplete="off" placeholder="Cartellino" required />
            </div>
            <span id="cardIdFeedback" asp-validation-for="Input.CardId" class="text-danger"></span>
        </div>

        <div class="picking-product-details" aria-live="polite">
            <div>
                <input id="productId" class="form-control" readonly placeholder="Articolo" aria-describedby="cardIdFeedback" />
            </div>
            <div>
                <div id="productDescription" class="picking-product-description" data-placeholder="Descrizione" aria-live="polite"></div>
            </div>
        </div>

        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                <input asp-for="Input.ProductionNumber" id="productionNumber" class="form-control" autocomplete="off" placeholder="Numero di produzione" required />
            </div>
            <span id="productionNumberFeedback" asp-validation-for="Input.ProductionNumber" class="text-danger"></span>
        </div>

        <div class="picking-field">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-123"></i></span>
                <input asp-for="Input.Quantity" id="quantity" class="form-control picking-quantity-input" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="Quantità" required />
            </div>
            <span id="quantityFeedback" asp-validation-for="Input.Quantity" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success w-100 picking-submit">
            <i class="bi bi-check2-circle"></i>Registra prelievo
        </button>
    </form>
</section>

@if (Model.PickingTransactions.Count > 0)
{
    <section class="kflow-mobile-card picking-history mt-3">
        <header class="picking-history-header">
            <div>
                <h2>Prelievi registrati</h2>
                <span>Articolo @Model.SelectedItemCode · Produzione @Model.SelectedProductionNumber</span>
            </div>
            <span class="picking-count">@Model.PickingTransactions.Count</span>
        </header>

        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Quantità</th>
                        <th class="text-end">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var transaction in Model.PickingTransactions)
                    {
                        <tr>
                            <td class="text-nowrap picking-date">@transaction.CreateDate.ToString("dd/MM HH:mm")</td>
                            <td>
                                <form method="post" asp-page-handler="Update" class="d-flex gap-1 picking-update-form" novalidate>
                                    <input type="hidden" name="id" value="@transaction.ID" />
                                    <input type="hidden" name="itemCode" value="@Model.SelectedItemCode" />
                                    <input type="hidden" name="production" value="@Model.SelectedProductionNumber" />
                                    <input name="quantity" class="form-control form-control-sm picking-row-quantity" type="number" min="0.01" step="0.01" inputmode="decimal" value="@transaction.Qty.ToString(System.Globalization.CultureInfo.InvariantCulture)" aria-label="Quantità del prelievo @transaction.ID" />
                                    <button type="submit" class="btn btn-outline-primary btn-sm picking-row-action" title="Salva quantità" aria-label="Salva quantità">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Eliminare questo movimento di prelievo?');">
                                    <input type="hidden" name="id" value="@transaction.ID" />
                                    <input type="hidden" name="itemCode" value="@Model.SelectedItemCode" />
                                    <input type="hidden" name="production" value="@Model.SelectedProductionNumber" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm picking-row-action" title="Elimina movimento" aria-label="Elimina movimento">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<div class="modal fade" id="pickingErrorModal" tabindex="-1" aria-labelledby="pickingErrorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header text-bg-danger">
                <h2 class="modal-title fs-6" id="pickingErrorModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Attenzione</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body" id="pickingErrorMessage"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger w-100" data-bs-dismiss="modal">Correggi</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const cardInput = document.getElementById("cardId");
            const productInput = document.getElementById("productId");
            const productDescriptionInput = document.getElementById("productDescription");
            const feedback = document.getElementById("cardIdFeedback");
            const productionInput = document.getElementById("productionNumber");
            const quantityInput = document.getElementById("quantity");
            const form = cardInput?.closest("form");
            const errorModalElement = document.getElementById("pickingErrorModal");
            const errorModalMessage = document.getElementById("pickingErrorMessage");
            const serverErrorMessage = @Json.Serialize(Model.ErrorMessage);

            function showPickingError(message) {
                if (!errorModalElement || !errorModalMessage) {
                    return;
                }

                errorModalMessage.textContent = message;
                bootstrap.Modal.getOrCreateInstance(errorModalElement).show();
            }

            if (!cardInput || !productInput || !productDescriptionInput || !feedback) {
                return;
            }

            if (serverErrorMessage) {
                showPickingError(serverErrorMessage);
            }

            async function loadProduct() {
                const cardId = cardInput.value.trim();
                productInput.value = "";
                productDescriptionInput.textContent = "";
                feedback.textContent = "";
                cardInput.setCustomValidity("");

                if (!cardId) {
                    return false;
                }

                try {
                    const response = await fetch(`${window.location.pathname}?handler=CardInfo&cardId=${encodeURIComponent(cardId)}`, {
                        headers: { "Accept": "application/json" }
                    });
                    const result = await response.json();

                    if (!response.ok || !result.found) {
                        feedback.textContent = result.message || "Cartellino non trovato.";
                        cardInput.setCustomValidity(feedback.textContent);
                        return false;
                    }

                    productInput.value = result.productId;
                    productDescriptionInput.textContent = result.productDescription || "";
                    return true;
                } catch {
                    feedback.textContent = "Impossibile verificare il cartellino.";
                    cardInput.setCustomValidity(feedback.textContent);
                    return false;
                }
            }

            cardInput.addEventListener("change", loadProduct);
            cardInput.addEventListener("blur", loadProduct);
            cardInput.addEventListener("keydown", async event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                if (await loadProduct()) {
                    productionInput?.focus();
                } else {
                    cardInput.focus();
                }
            });

            productionInput?.addEventListener("keydown", async event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                const production = productionInput.value.trim();

                if (!production) {
                    productionInput.focus();
                    return;
                }

                if (!productInput.value.trim() && !(await loadProduct())) {
                    return;
                }

                const parameters = new URLSearchParams({
                    itemCode: productInput.value.trim(),
                    production,
                    cardId: cardInput.value.trim()
                });
                window.location.assign(`${window.location.pathname}?${parameters.toString()}`);
            });

            quantityInput?.addEventListener("keydown", event => {
                if (event.key !== "Enter") {
                    return;
                }

                event.preventDefault();
                form?.requestSubmit();
            });

            if (cardInput.value.trim()) {
                loadProduct();
            }

            if (new URLSearchParams(window.location.search).has("production")) {
                window.setTimeout(() => quantityInput?.focus(), 0);
            }

            document.querySelectorAll(".picking-update-form").forEach(updateForm => {
                updateForm.addEventListener("submit", event => {
                    const rowQuantity = updateForm.querySelector("[name='quantity']");
                    const value = Number(rowQuantity?.value);

                    if (!rowQuantity?.value.trim() || !rowQuantity.validity.valid || !Number.isFinite(value) || value <= 0) {
                        event.preventDefault();
                        showPickingError("Inserisci una quantità numerica maggiore di zero.");
                        rowQuantity?.focus();
                    }
                });
            });

            form?.addEventListener("submit", event => {
                const requiredFields = [
                    [cardInput, feedback, "Inserisci il cartellino."],
                    [productionInput, document.getElementById("productionNumberFeedback"), "Inserisci il numero di produzione."],
                    [quantityInput, document.getElementById("quantityFeedback"), "Inserisci la quantità."]
                ];
                const missingField = requiredFields.find(([field, error]) => {
                    const isMissing = !field?.value.trim();
                    if (isMissing) {
                        field.classList.add("is-invalid");
                        error.textContent = error.textContent || "Campo obbligatorio.";
                    } else {
                        field.classList.remove("is-invalid");
                    }
                    return isMissing;
                });

                if (missingField) {
                    event.preventDefault();
                    missingField[0].focus();
                }
            });
        })();
    </script>
}
