@page
@model Scheletro.Pages.User.IndexModel
@{
    ViewData["Title"] = "Area utente";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-warning shadow-sm" role="alert">
                    @Model.StatusMessage
                </div>
            }

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
                        <div>
                            <span class="badge rounded-pill text-bg-primary mb-3">Ruolo: @Model.Role</span>
                            <h1 class="h3 mb-2">Area utente</h1>
                            <p class="text-secondary mb-0">
                                Questa pagina e disponibile per gli utenti autenticati che non appartengono al ruolo Admin.
                            </p>
                        </div>

                        <a asp-page="/Admin/Logout" class="btn btn-outline-secondary">Esci</a>
                    </div>

                    <div class="p-4 rounded-4 bg-light border">
                        <p class="mb-2">
                            <strong>Utente autenticato:</strong> @Model.Username
                        </p>
                        <p class="mb-0">
                            Il ruolo viene recuperato dal database in fase di login, salvato nel cookie come claim
                            e controllato automaticamente dalle policy di autorizzazione.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
